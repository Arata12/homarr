# Generate two distinct 64-character hex secrets before deploying:
#   openssl rand -hex 32
SECRET_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
AUTH_SECRET=fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210

HOST=0.0.0.0
PORT=7575
LOG_LEVEL=info
ASSETS_DIR=/app/assets
STATIC_DATA_DIR=/appdata
LOCAL_CERTIFICATE_PATH=/appdata/trusted-certificates

# Database driver: sqlite (default) or postgres
DB_DRIVER=sqlite
DB_URL=/appdata/db/db.sqlite
# Example PostgreSQL configuration:
# DB_DRIVER=postgres
# DB_URL=postgres://homarr:homarr@postgres:5432/homarrdb

# Redis configuration
REDIS_IS_EXTERNAL=true
REDIS_HOST=redis
REDIS_PORT=6379
# REDIS_USERNAME=
# REDIS_PASSWORD=
# REDIS_DB=0
# REDIS_DISABLED=true

# Optional Docker & Kubernetes integration
# DOCKER_SOCKET_PATHS=/var/run/docker.sock
# DOCKER_HOSTNAMES=
# DOCKER_PORTS=
# ENABLE_KUBERNETES=false

# Feature flags
UNSAFE_ENABLE_MOCK_INTEGRATION=true
NO_EXTERNAL_CONNECTION=false
DEMO_MODE=false
DEMO_READ_ONLY=true

# Workshop integration
WORKSHOP_API_URL=http://workshop:8090
WORKSHOP_WEB_URL=http://localhost:8090
