FROM rust:1-bookworm

RUN rustup component add clippy rustfmt && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
      ca-certificates \
      curl \
      pkg-config \
      sqlite3 && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /workspace
ENV CARGO_TARGET_DIR=/cargo-target
