# syntax=docker/dockerfile:1
#
# Release image: packages the static (musl) binaries built by
# .github/workflows/release.yml. Nothing is compiled here.
#
# Expected build context layout:
#   bin/homarr-server
#   bin/homarr
#   bin/homarr-workshop
#   assets/
#
# distroless/static: no shell or package manager. It ships /etc/passwd,
# /tmp, CA certificates and tzdata, adding only about 2 MB to the image.
#
# Runs as the distroless `nonroot` user (65532:65532). PUID/PGID are NOT
# supported here (no shell to drop privileges); use `user: "<uid>:<gid>"` in
# compose instead and make the /appdata volume writable by that uid. Reaching
# /var/run/docker.sock needs `group_add: ["<docker socket gid>"]`.

# The debug variant only provides a busybox shell to prepare /appdata.
FROM --platform=$BUILDPLATFORM gcr.io/distroless/static-debian13:debug AS appdata
RUN ["/busybox/sh", "-c", "mkdir -p /out/appdata/db /out/appdata/secrets /out/appdata/trusted-certificates"]

FROM gcr.io/distroless/static-debian13:nonroot

COPY --chmod=0755 bin/homarr-server bin/homarr bin/homarr-workshop /usr/local/bin/
COPY assets /app/assets
# Copy the contents of /out so `appdata` itself is a copied entry and gets --chown.
COPY --from=appdata --chown=65532:65532 /out/ /

WORKDIR /app

ENV HOST=0.0.0.0 \
    PORT=7575 \
    ASSETS_DIR=/app/assets \
    STATIC_DATA_DIR=/appdata \
    DB_DRIVER=sqlite \
    DB_URL=/appdata/db/db.sqlite

EXPOSE 7575
VOLUME ["/appdata"]

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD ["/usr/local/bin/homarr", "healthcheck"]
CMD ["/usr/local/bin/homarr-server"]
