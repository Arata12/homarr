# syntax=docker/dockerfile:1

FROM rust:1-bookworm AS builder
WORKDIR /workspace

RUN apt-get update && apt-get install -y --no-install-recommends \
    pkg-config sqlite3 \
    && rm -rf /var/lib/apt/lists/*

COPY Cargo.toml Cargo.lock* ./
COPY crates ./crates
COPY migrations ./migrations

RUN cargo build --release --bin homarr-workshop

FROM debian:bookworm-slim AS runner
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /data /app/public

WORKDIR /app
COPY --from=builder /workspace/target/release/homarr-workshop /usr/local/bin/homarr-workshop
COPY assets/public /app/public

ENV HOST=0.0.0.0 \
    PORT=8090 \
    WORKSHOP_DB_URL=/data/workshop.sqlite \
    WORKSHOP_PUBLIC_DIR=/app/public

EXPOSE 8090
HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=5 \
  CMD curl -fsS http://127.0.0.1:8090/api/health || exit 1

CMD ["/usr/local/bin/homarr-workshop"]
